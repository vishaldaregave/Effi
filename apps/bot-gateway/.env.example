# Telegram Bot API
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_MESSAGE_DEDUPE_PATH=.data/telegram-message-ids.json

# Durable anonymous drafts. Use a random deployment secret; never rotate it while drafts may resume.
CONVEX_URL=
EFFI_DRAFT_SCOPE_SECRET=
EFFI_GATEWAY_CONVEX_SECRET=

# Vercel AI Gateway STT (OpenAI Whisper with language auto-detection) and Cartesia Sonic 3.6 TTS
AI_GATEWAY_API_KEY=
# Optional override
AI_GATEWAY_TRANSCRIPTION_MODEL=openai/whisper-1
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# Legacy Deepgram provider, kept for reference; the gateway voice path does not use it.
DEEPGRAM_API_KEY=

# OpenCode Go model (Muse Spark 1.3 Contributor). The start script falls back
# to the opencode-go credential in ~/.local/share/opencode/auth.json.
OPENCODE_API_KEY=
# Optional overrides
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_MODEL=muse-spark-1.3-contributor

# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Authentication callback integration
EFFI_AUTHENTICATION_BASE_URL=
EFFI_AUTH_CALLBACK_SECRET=

# Effi-controlled media storage
EFFI_MEDIA_ROOT=.effi/media

# Direct Baileys channel. Use comma-separated E.164 numbers without the +.
# The channel fails closed when the allowlist is empty. Auth, provider-ID
# claims, and copied media must live on durable, access-controlled storage.
WHATSAPP_CONNECT=1
WHATSAPP_ALLOWED_NUMBERS=
WHATSAPP_AUTH_DIR=.data/whatsapp-auth
WHATSAPP_MEDIA_DIR=.data/whatsapp-media
